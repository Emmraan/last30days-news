# Local development settings. Copy to .env.development; that file is ignored.
#
# Turso is optional for local development. Leave both blank to use a local
# SQLite file. To test the Vercel database path, create a Turso libSQL
# development branch and fill both values. Use the branch's `libsql://` URL,
# not a `turso://` URL from the newer Turso Database engine. Never use the
# production branch here.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Deployed-mode auth, for testing Vercel/VPS behavior locally. Put these in
# .env.development.local (Vite loads it last) or the shell, not in this file.
# L30_DEPLOYED=1 disables the local default `last30` and password reset.
# L30_INITIAL_PASSWORD is the first password, 8+ characters.
#L30_DEPLOYED=1
#L30_INITIAL_PASSWORD=choose-a-password

# Optional settings. Empty means "use the default".

# Local SQLite folder. Defaults to the platform app data directory. Ignored
# when TURSO_DATABASE_URL is set. Used by `pnpm dev`, `pnpm start` and `npx`.
L30_DATA_DIR=

# Set to 1 for debug logs. Local and VPS only; leave unset on Vercel.
L30_DEBUG=

# Set to 1 only when a VPS reverse proxy overwrites X-Forwarded-Proto and
# X-Forwarded-For. Never set it for a directly exposed local port. Vercel
# handles its own proxy and does not need this.
L30_TRUST_PROXY=

# Listen address for the packaged app (`pnpm start` / `npx`). Defaults to
# 127.0.0.1 on the first free port from 4477 to 4487. Vite dev uses its own
# --port flag. Vercel ignores both values.
PORT=
HOST=

# Set to 1 to stop the packaged app from opening a browser. CI sets this
# automatically; Vercel ignores it.
CI=
