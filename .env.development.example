# Copy to .env.development. Real values stay there and are ignored by git.
# Leave Turso blank to use the local SQLite file.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# To test deployed-mode auth locally, set these in the shell instead:
# L30_DEPLOYED=1 L30_INITIAL_PASSWORD=choose-a-password

# Optional local settings.
L30_DATA_DIR=
L30_DEBUG=
L30_TRUST_PROXY=
PORT=
HOST=
CI=
