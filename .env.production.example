# Production-like local settings. Copy to .env.production for `pnpm start:local`.
# On Vercel, set these in Project Settings > Environment Variables instead;
# Vercel sets VERCEL=1 and does not read this file.
#
# Required for Vercel and for any remote Turso run.
# TURSO_DATABASE_URL: the libSQL URL (`libsql://...`) from the Turso database.
#   A `turso://` URL belongs to the newer Turso Database engine, not libSQL,
#   and @libsql/client cannot open it.
# TURSO_AUTH_TOKEN: token with read/write access to that database.
TURSO_DATABASE_URL=libsql://example.turso.io
TURSO_AUTH_TOKEN=replace-with-token

# Deployment mode. Docker and the systemd unit set it; Vercel sets VERCEL=1
# instead. Either one disables the local default `last30` and reset.
L30_DEPLOYED=1

# First password, 8+ characters. Read only while the database has no password.
# Required on the first boot of Docker, VPS and Vercel; change it in Settings
# afterwards. Never commit a real value.
L30_INITIAL_PASSWORD=replace-with-a-password

# Optional settings. Empty means "use the default".

# Local SQLite folder. Defaults to the platform app data directory. Ignored
# when TURSO_DATABASE_URL is set, and ignored on Vercel. Used by a non-Turso
# local production run.
L30_DATA_DIR=

# Set to 1 for debug logs. Local and VPS only; leave unset on Vercel.
L30_DEBUG=

# Set to 1 only when a VPS reverse proxy overwrites X-Forwarded-Proto and
# X-Forwarded-For. Never set it for a directly exposed port. Vercel handles
# its own proxy and does not need this.
L30_TRUST_PROXY=

# Listen address for the packaged app. Defaults to 127.0.0.1 on the first free
# port from 4477 to 4487. Docker and the systemd unit set their own values;
# Vercel ignores both.
PORT=
HOST=

# Set to 1 to stop the packaged app from opening a browser. Docker and systemd
# already pass --no-open; use this for a headless local production run.
CI=
