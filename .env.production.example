# Copy to .env.production for a production-like local run. Vercel gets these
# values from the project environment instead.
TURSO_DATABASE_URL=libsql://example.turso.io
TURSO_AUTH_TOKEN=replace-with-token
L30_DEPLOYED=1
L30_INITIAL_PASSWORD=replace-with-a-password

# Optional local settings.
L30_DATA_DIR=
L30_DEBUG=
L30_TRUST_PROXY=
PORT=
HOST=
