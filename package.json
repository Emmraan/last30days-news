{
  "name": "last30days-news",
  "version": "0.1.0",
  "description": "A local reader for the last 30 days of technology news.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Emmraan/last30days-news.git"
  },
  "type": "module",
  "keywords": [
    "news",
    "rss",
    "reader",
    "ai",
    "sveltekit"
  ],
  "bin": {
    "last30days": "bin/last30days.js"
  },
  "files": [
    "bin/last30days.js",
    "bin/options.mjs",
    "build/**/*.js",
    "build/**/*.css",
    "build/**/*.json",
    "build/**/*.br",
    "build/**/*.gz",
    "docs/assets/*.svg",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "26.13.0"
  },
  "scripts": {
    "dev": "vite dev",
    "start": "node bin/last30days.js",
    "start:local": "node --env-file=.env.production bin/last30days.js",
    "build": "vite build",
    "build:landing": "pnpm --filter last30days-news-landing build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:changed": "node scripts/changed.mjs --lint",
    "format": "prettier --write .",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "typecheck:changed": "node scripts/changed.mjs --typecheck",
    "test": "vitest run",
    "test:changed": "node scripts/changed.mjs --test",
    "test:smoke": "node scripts/smoke.mjs",
    "test:package": "node scripts/package-smoke.mjs",
    "budget": "node scripts/budget.mjs",
    "audit:gate": "node scripts/audit.mjs",
    "prepack": "pnpm build",
    "db:generate": "drizzle-kit generate"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/github": "12.0.11",
    "@semantic-release/npm": "13.2.0",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@sveltejs/adapter-node": "6.0.5",
    "@sveltejs/adapter-vercel": "7.0.5",
    "@sveltejs/kit": "3.4.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "drizzle-kit": "0.31.11",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.24.1",
    "lucide-svelte": "1.0.1",
    "prettier": "3.10.1",
    "prettier-plugin-svelte": "4.2.0",
    "semantic-release": "25.0.9",
    "svelte": "5.59.1",
    "svelte-check": "4.7.8",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.107",
    "@ai-sdk/google": "4.0.124",
    "@ai-sdk/openai": "4.0.122",
    "@ai-sdk/openai-compatible": "3.0.94",
    "@libsql/client": "0.18.0",
    "ai": "7.0.179",
    "drizzle-orm": "0.45.4",
    "rss-parser": "3.13.0",
    "zod": "4.6.7"
  }
}
