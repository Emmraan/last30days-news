# Copy to .env for local development. Production passes real values.
# Turso is required on Vercel and ignored for a local file install.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Public deployment mode. Docker and the systemd unit set this. It disables
# the local default password and password reset.
L30_DEPLOYED=
# First password for a deployed install, 8+ characters. Read once when the
# database has no password; later changes in Settings win.
L30_INITIAL_PASSWORD=

# Optional local settings.
L30_DATA_DIR=
L30_DEBUG=
L30_TRUST_PROXY=
PORT=
HOST=
CI=
